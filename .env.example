# ============================================================
# ETL-Agent Environment Configuration Template
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ============================================================

# ---- Environment ----
ENV=development
LOG_LEVEL=INFO

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_USER=etl_agent
POSTGRES_PASSWORD=changeme
POSTGRES_DB=etl_agent
DATABASE_URL=postgresql+psycopg://etl_agent:changeme@localhost:15432/etl_agent

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# ---- SeaTunnel Zeta ----
SEATUNNEL_HOST=localhost
SEATUNNEL_PORT=5801
# 2.3.x uses the legacy Hazelcast REST API; switch to v2 only when using a new SeaTunnel version
SEATUNNEL_API_VERSION=legacy

# ---- HashiCorp Vault ----
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root
VAULT_SECRET_PATH=etl-agent

# Optional: share the same Ed25519 private key across API and Celery workers.
# Leave empty in development; a random key is generated per process.
CAPABILITY_PRIVATE_KEY_PEM=

# ---- JWT ----
JWT_SECRET_KEY=change-this-to-a-random-string
JWT_ALGORITHM=HS256
# 0 = 登录令牌永不过期（JWT 不带 exp）；非 0 = 有效分钟数，例如 480 = 8 小时。
# 生产/共享环境请保持正数：令牌一旦泄露，只能靠轮换 JWT_SECRET_KEY 让其失效。
JWT_EXPIRE_MINUTES=480

# ---- LLM Model API ----
MODEL_API_KEY=ollama
MODEL_API_BASE=http://127.0.0.1:11434/v1
MODEL_NAME=qwen2.5-coder:7b

# ---- Knowledge Q&A local model (Ollama / OpenAI-compatible) ----
KNOWLEDGE_LLM_BASE_URL=http://127.0.0.1:11434/v1
KNOWLEDGE_LLM_MODEL=qwen2.5-coder:7b
KNOWLEDGE_LLM_API_KEY=ollama

# ---- FastAPI ----
API_V1_PREFIX=/api/v1
